<?xml version="1.0" encoding="utf-8"?>
<!-- Tylko szyfrowane połączenia (HTTPS); bez ruchu jawnego i bez zaufania do certyfikatów dodanych przez użytkownika. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
